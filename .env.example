# Envio do lead para o Salesforce (via n8n). Desligado por padrão.
# Só liga quando LEAD_WEBHOOK_ENABLED=true e a URL estiver preenchida.
LEAD_WEBHOOK_ENABLED=false
# Use o mesmo webhook do n8n da v6 (peça a URL ao Wendell); não versione a URL real.
LEAD_WEBHOOK_URL=https://n8n.exemplo.com.br/webhook/SEU-ID

# Modo revisão: libera /variacoes e o atalho ?etapa=<id>&perfil=<preset>,
# que pula o formulário. Deixe desligado em produção.
NEXT_PUBLIC_MODO_REVISAO=false

# Opcional: URL que recebe os eventos de funil (além do dataLayer do GTM).
NEXT_PUBLIC_ANALYTICS_WEBHOOK=
